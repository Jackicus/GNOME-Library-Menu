{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/nested.sh session-end",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/kit.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "gnome-extensions": {
      "source": {
        "source": "directory",
        "path": "../.gnome-ai-kit"
      }
    }
  },
  "enabledPlugins": {
    "gnome-ext@gnome-extensions": true
  }
}
